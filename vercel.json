{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/:path(.*)?",
      "has": [
        {
          "type": "host",
          "value": "www.jususervisas.lt"
        }
      ],
      "destination": "https://jususervisas.lt/:path",
      "permanent": true
    },
    {
      "source": "/kondicionieriu-pildymas",
      "destination": "/paslaugos/kondicionieriaus-pildymas",
      "permanent": true
    },
    {
      "source": "/kondicionieriu-pildymas/",
      "destination": "/paslaugos/kondicionieriaus-pildymas",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
